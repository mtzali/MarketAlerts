BARS = "━" * 58

def bar(char="─", n=58):
    return char * n


def signal_emoji(direction: str) -> str:
    if "BULLISH" in direction and "WEAK" not in direction:
        return "🟢"
    elif "BEARISH" in direction and "WEAK" not in direction:
        return "🔴"
    elif "WEAK BULLISH" in direction:
        return "🟡"
    elif "WEAK BEARISH" in direction:
        return "🟡"
    return "⚪"


def strength_bar(strength: int, total: int = 5) -> str:
    filled = "█" * strength
    empty  = "░" * (total - strength)
    return f"[{filled}{empty}] {strength}/{total}"


def format_report(sig: dict, report_type: str = "HOURLY") -> str:
    now_et = datetime.now(ZoneInfo(TIMEZONE))
    lines = [
        "",
        BARS,
        f"  RTY ICHIMOKU SIGNAL REPORT  —  {report_type}",
        f"  {now_et.strftime('%A, %B %d %Y  %I:%M %p ET')}",
        BARS,
        "",
        f"  TICKER ANALYZED : {TICKER} (Russell 2000 Futures, 4H)",
        f"  INSTRUMENT      : {sig['instrument']}",
        f"  DIRECTION       : {signal_emoji(sig['direction'])}  {sig['direction']}",
        f"  SIGNAL STRENGTH : {strength_bar(sig['strength'])}",
        "",
        bar(),
        "  ICHIMOKU VALUES",
        bar(),
        f"  Close Price     :  {sig['close_price']:>10.2f}",
        f"  Tenkan-sen      :  {sig['tenkan']:>10.2f}",
        f"  Kijun-sen       :  {sig['kijun']:>10.2f}",
        f"  Cloud Top       :  {sig['cloud_top']:>10.2f}",
        f"  Cloud Bottom    :  {sig['cloud_bottom']:>10.2f}",
        f"  Cloud Color     :  {'🟩 GREEN' if sig['cloud_color'] == 'GREEN' else '🟥 RED'}",
        f"  Future Cloud    :  {'🟩 GREEN (bullish ahead)' if sig['future_cloud'] == 'GREEN' else '🟥 RED (bearish ahead)'}",
        f"  Inside Cloud?   :  {'⚠️  YES — avoid trading' if sig['inside_cloud'] else '✅  NO — signals valid'}",
        "",
    ]

    # Conditions checklist
    if sig.get("conditions"):
        lines += [bar(), "  CONDITIONS MET", bar()]
        for condition, met in sig["conditions"].items():
            icon = "✅" if met else "❌"
            lines.append(f"  {icon}  {condition}")
        lines.append("")

    # Trade setup
    if sig["strength"] >= MIN_SIGNAL_STRENGTH and not sig["inside_cloud"]:
        lines += [
            bar(),
            f"  TRADE SETUP — {sig['instrument']}",
            bar(),
            f"  Entry Zone      :  {sig['entry_zone_low']:.2f}  –  {sig['entry_zone_high']:.2f}",
            f"  Stop Loss       :  {sig['stop_loss']:.2f}  (Kijun-sen level)",
            f"  Target 1R       :  {sig['target_1r']:.2f}  (1:1 reward)",
            f"  Target 2R       :  {sig['target_2r']:.2f}  ★ 2:1 reward target",
            "",
            f"  Risk (pts)      :  {abs(sig['close_price'] - sig['stop_loss']):.2f} RTY points",
            f"  Reward (pts)    :  {abs(sig['target_2r'] - sig['close_price']):.2f} RTY points",
            "",
            "  📌 NOTE: These levels are on RTY futures.",
            "     URTY/SRTY are 3x leveraged ETFs — a 1% RTY move",
            "     ≈ 3% URTY/SRTY move. Size positions accordingly.",
            "",
        ]
    else:
        lines += [
            bar(),
            "  ⏳ NO ACTIONABLE SETUP RIGHT NOW",
            "",
            "  Waiting for full Ichimoku alignment (4/5 conditions).",
            "  This is normal — patience is the edge.",
            "",
        ]

    # Exit rules reminder
    lines += [
        bar(),
        "  EXIT RULES (check every 4H candle)",
        bar(),
        "  • Price re-enters cloud    → Exit immediately",
        "  • Kijun-sen breached       → Tighten stop or exit",
        "  • TK Cross reverses        → Exit",
        "  • 2R target hit            → Take profit",
        "  • Hold max 3-5 days        → Avoid leveraged ETF decay",
        "",
        BARS,
        "  ⚠️  NOT FINANCIAL ADVICE. Educational analysis only.",
        "     Always use proper position sizing and risk management.",
        BARS,
        "",
    ]

    return "\n".join(lines)


def print_signal_history(conn: sqlite3.Connection, n: int = 10):
    rows = get_recent_signals(conn, n)
    if not rows:
        print("\n  No signals in database yet.\n")
        return

    print(f"\n{BARS}")
    print(f"  LAST {n} SIGNALS FROM DATABASE")
    print(BARS)
    print(f"  {'Time':<22} {'Dir':<10} {'ETF':<6} {'Price':>8} {'Stop':>8} {'2R':>8} {'Str'}")
    print(bar())
    for row in rows:
        created, sig_time, direction, instrument, price, stop, t2r, strength, conditions, _ = row
        short_dir = direction[:9]
        print(f"  {sig_time[:19]:<22} {short_dir:<10} {instrument:<6} {price:>8.2f} {stop:>8.2f} {t2r:>8.2f}  {strength}/5")
    print(BARS + "\n")


# ══════════════════════════════════════════════
#  CORE ANALYSIS RUNNER
# ══════════════════════════════════════════════

def run_analysis(conn: sqlite3.Connection, report_type: str = "HOURLY") -> dict:
    """Fetch data, calculate Ichimoku, evaluate signal, save to DB, print report."""
    log.info(f"Running {report_type} analysis...")

    # 1. Fetch data
    df_4h = fetch_rtx_4h(lookback_days=90)
    if df_4h.empty:
        log.warning("No data available — skipping analysis.")
        return {}

    # 2. Save candles
    save_candles(conn, df_4h)

    # 3. Calculate Ichimoku
    ichi = calculate_ichimoku(df_4h)
    save_ichimoku(conn, ichi)

    # 4. Evaluate signal
    sig = evaluate_signals(ichi)
    if not sig:
        return {}

    # 5. Print report
    report = format_report(sig, report_type)
    print(report)

    # 6. Save signal to DB if actionable
    if sig["strength"] >= MIN_SIGNAL_STRENGTH:
        now_str     = datetime.now(ZoneInfo(TIMEZONE)).isoformat()
        sig_time    = str(ichi.index[-1])
        conditions_str = ", ".join(
            k for k, v in sig.get("conditions", {}).items() if v
        )
        signal_record = {
            "created_at":       now_str,
            "signal_time":      sig_time,
            "direction":        sig["direction"],
            "instrument":       sig["instrument"],
            "close_price":      sig["close_price"],
            "entry_zone_low":   sig["entry_zone_low"],
            "entry_zone_high":  sig["entry_zone_high"],
            "stop_loss":        sig["stop_loss"],
            "target_1r":        sig["target_1r"],
            "target_2r":        sig["target_2r"],
            "strength":         sig["strength"],
            "conditions_met":   conditions_str,
            "notes":            f"{report_type} scan",
        }
        record_id = save_signal(conn, signal_record)
        log.info(f"Signal saved to DB (id={record_id}): {sig['direction']} | {sig['instrument']} | strength={sig['strength']}/5")

    return sig


