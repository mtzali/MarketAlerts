def init_db(db_path: str) -> sqlite3.Connection:
    """Create tables if they don't exist."""
    conn = sqlite3.connect(db_path)
    c = conn.cursor()

    # 4H OHLCV candles
    c.execute("""
        CREATE TABLE IF NOT EXISTS candles_4h (
            datetime    TEXT PRIMARY KEY,
            open        REAL,
            high        REAL,
            low         REAL,
            close       REAL,
            volume      REAL
        )
    """)

    # Ichimoku values per candle
    c.execute("""
        CREATE TABLE IF NOT EXISTS ichimoku_4h (
            datetime        TEXT PRIMARY KEY,
            close           REAL,
            tenkan          REAL,
            kijun           REAL,
            span_a          REAL,
            span_b          REAL,
            chikou          REAL,
            cloud_top       REAL,
            cloud_bottom    REAL,
            cloud_color     TEXT,
            future_cloud_top    REAL,
            future_cloud_bottom REAL,
            future_cloud_color  TEXT
        )
    """)

    # Signals generated
    c.execute("""
        CREATE TABLE IF NOT EXISTS signals (
            id              INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at      TEXT,
            signal_time     TEXT,
            direction       TEXT,
            instrument      TEXT,
            close_price     REAL,
            entry_zone_low  REAL,
            entry_zone_high REAL,
            stop_loss       REAL,
            target_1r       REAL,
            target_2r       REAL,
            strength        INTEGER,
            conditions_met  TEXT,
            notes           TEXT
        )
    """)

    conn.commit()
    return conn


def save_candles(conn: sqlite3.Connection, df: pd.DataFrame):
    """Upsert 4H candles into DB."""
    c = conn.cursor()
    for dt, row in df.iterrows():
        c.execute("""
            INSERT OR REPLACE INTO candles_4h
            (datetime, open, high, low, close, volume)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (
            str(dt), row["Open"], row["High"],
            row["Low"], row["Close"], row.get("Volume", 0)
        ))
    conn.commit()


def save_ichimoku(conn: sqlite3.Connection, df: pd.DataFrame):
    """Upsert Ichimoku values into DB."""
    c = conn.cursor()
    for dt, row in df.iterrows():
        c.execute("""
            INSERT OR REPLACE INTO ichimoku_4h
            (datetime, close, tenkan, kijun, span_a, span_b,
             chikou, cloud_top, cloud_bottom, cloud_color,
             future_cloud_top, future_cloud_bottom, future_cloud_color)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            str(dt),
            row.get("close"), row.get("tenkan"), row.get("kijun"),
            row.get("span_a"), row.get("span_b"), row.get("chikou"),
            row.get("cloud_top"), row.get("cloud_bottom"), row.get("cloud_color"),
            row.get("future_cloud_top"), row.get("future_cloud_bottom"),
            row.get("future_cloud_color"),
        ))
    conn.commit()


def save_signal(conn: sqlite3.Connection, signal: dict):
    """Insert a new signal record."""
    c = conn.cursor()
    c.execute("""
        INSERT INTO signals
        (created_at, signal_time, direction, instrument, close_price,
         entry_zone_low, entry_zone_high, stop_loss, target_1r,
         target_2r, strength, conditions_met, notes)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        signal["created_at"], signal["signal_time"], signal["direction"],
        signal["instrument"], signal["close_price"],
        signal["entry_zone_low"], signal["entry_zone_high"],
        signal["stop_loss"], signal["target_1r"], signal["target_2r"],
        signal["strength"], signal["conditions_met"], signal["notes"],
    ))
    conn.commit()
    return c.lastrowid


def get_recent_signals(conn: sqlite3.Connection, n: int = 10) -> list:
    """Fetch the N most recent signals."""
    c = conn.cursor()
    c.execute("""
        SELECT created_at, signal_time, direction, instrument,
               close_price, stop_loss, target_2r, strength, conditions_met, notes
        FROM signals
        ORDER BY id DESC
        LIMIT ?
    """, (n,))
    return c.fetchall()


