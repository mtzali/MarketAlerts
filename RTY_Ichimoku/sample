def main():
    parser = argparse.ArgumentParser(description="RTY Ichimoku Signal System")
    parser.add_argument("--now",     action="store_true", help="Run analysis immediately and exit")
    parser.add_argument("--report",  action="store_true", help="Print full report now and keep running scheduler")
    parser.add_argument("--history", type=int, metavar="N", help="Show last N signals from DB and exit")
    args = parser.parse_args()

    print(f"\n{BARS}")
    print("  RTY ICHIMOKU SIGNAL SYSTEM — Starting up")
    print(f"  Database : {DB_PATH}")
    print(f"  Timezone : {TIMEZONE}")
    print(f"  Min Signal Strength : {MIN_SIGNAL_STRENGTH}/5 to alert")
    print(BARS)

    # Init DB
    conn = init_db(DB_PATH)
    log.info("Database initialized.")

    # ── CLI shortcuts ───────────────────────
    if args.history:
        print_signal_history(conn, args.history)
        conn.close()
        return

    if args.now:
        run_analysis(conn, report_type="MANUAL RUN")
        conn.close()
        return

    if args.report:
        run_analysis(conn, report_type="MANUAL REPORT")
        # Fall through to scheduler

    # ── Schedule jobs ───────────────────────
    # Hourly analysis (every hour on the hour)
    schedule.every().hour.do(hourly_job, conn=conn)

    # Sunday weekly preview at 8:00 AM ET
    schedule.every().sunday.at("08:00").do(sunday_weekly_report, conn=conn)

    # Daily pre-market at 9:00 AM ET
    schedule.every().day.at("09:00").do(daily_premarket_report, conn=conn)

    log.info("Scheduler started:")
    log.info("  • Hourly analysis (every hour)")
    log.info("  • Sunday 8:00 AM ET — weekly preview")
    log.info("  • Daily  9:00 AM ET — pre-market report")
    log.info("Press Ctrl+C to stop.\n")

    # Run once immediately on startup
    run_analysis(conn, report_type="STARTUP ANALYSIS")

    # Keep running
    try:
        while True:
            schedule.run_pending()
            time.sleep(30)   # check every 30 seconds
    except KeyboardInterrupt:
        log.info("Stopped by user.")
    finally:
        conn.close()
        log.info("Database connection closed.")


if __name__ == "__main__":
    main()