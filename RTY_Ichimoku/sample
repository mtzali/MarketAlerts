def hourly_job(conn):
    run_analysis(conn, report_type="HOURLY UPDATE")


def sunday_weekly_report(conn):
    now = datetime.now(ZoneInfo(TIMEZONE))
    if now.weekday() == 6:   # Sunday
        run_analysis(conn, report_type="SUNDAY WEEKLY PREVIEW")
    # schedule library calls this every week on Sunday regardless


def daily_premarket_report(conn):
    run_analysis(conn, report_type="DAILY PRE-MARKET 9AM")


