def evaluate_signals(ichi: pd.DataFrame) -> dict:
    """
    Evaluate the latest 4H candle for URTY / SRTY signals.
    Returns a dict with direction, strength, conditions, and trade levels.
    """
    # Need at least 3 rows to detect TK cross
    if len(ichi) < 3:
        return {"direction": "NEUTRAL", "strength": 0}

    latest = ichi.iloc[-1]
    prev   = ichi.iloc[-2]

    price        = latest["close"]
    tenkan       = latest["tenkan"]
    kijun        = latest["kijun"]
    cloud_top    = latest["cloud_top"]
    cloud_bottom = latest["cloud_bottom"]
    chikou       = latest["chikou"]
    fct          = latest["future_cloud_color"]   # future cloud color
    cloud_color  = latest["cloud_color"]

    # ── BULLISH CONDITIONS (for URTY) ──────────────────────────
    bull_conditions = {
        "Price above cloud":      price > cloud_top,
        "TK bullish cross":       (tenkan > kijun) and (prev["tenkan"] <= prev["kijun"]),
        "Tenkan above Kijun":     tenkan > kijun,
        "Future cloud is GREEN":  fct == "GREEN",
        "Chikou above price":     (not pd.isna(chikou)) and (chikou > price),
    }

    # ── BEARISH CONDITIONS (for SRTY) ──────────────────────────
    bear_conditions = {
        "Price below cloud":      price < cloud_bottom,
        "TK bearish cross":       (tenkan < kijun) and (prev["tenkan"] >= prev["kijun"]),
        "Tenkan below Kijun":     tenkan < kijun,
        "Future cloud is RED":    fct == "RED",
        "Chikou below price":     (not pd.isna(chikou)) and (chikou < price),
    }

    # ── INSIDE CLOUD check ─────────────────────────────────────
    inside_cloud = cloud_bottom <= price <= cloud_top

    bull_score = sum(bull_conditions.values())
    bear_score = sum(bear_conditions.values())

    # ── DETERMINE DIRECTION ────────────────────────────────────
    if inside_cloud:
        direction  = "NEUTRAL (inside cloud — avoid trading)"
        conditions = {"warning": "Price is inside the cloud — Ichimoku signals are unreliable here"}
        strength   = 0
        instrument = "WAIT"
    elif bull_score >= bear_score and bull_score >= MIN_SIGNAL_STRENGTH:
        direction  = "BULLISH"
        conditions = bull_conditions
        strength   = bull_score
        instrument = "URTY"
    elif bear_score > bull_score and bear_score >= MIN_SIGNAL_STRENGTH:
        direction  = "BEARISH"
        conditions = bear_conditions
        strength   = bear_score
        instrument = "SRTY"
    elif bull_score > bear_score:
        direction  = "WEAK BULLISH (wait for more confirmation)"
        conditions = bull_conditions
        strength   = bull_score
        instrument = "WAIT — watch for URTY"
    elif bear_score > bull_score:
        direction  = "WEAK BEARISH (wait for more confirmation)"
        conditions = bear_conditions
        strength   = bear_score
        instrument = "WAIT — watch for SRTY"
    else:
        direction  = "NEUTRAL"
        conditions = {}
        strength   = 0
        instrument = "WAIT"

    # ── CALCULATE TRADE LEVELS ─────────────────────────────────
    # Stop = Kijun-sen (most logical dynamic stop)
    # Target = 2:1 reward from entry to stop distance
    risk = abs(price - kijun)

    if "BULLISH" in direction:
        stop_loss      = kijun - (risk * 0.05)   # slight buffer below kijun
        target_1r      = price + risk
        target_2r      = price + (risk * 2)
        entry_low      = price
        entry_high     = price + (risk * 0.3)    # entry zone (don't chase beyond 30% of risk)
    elif "BEARISH" in direction:
        stop_loss      = kijun + (risk * 0.05)
        target_1r      = price - risk
        target_2r      = price - (risk * 2)
        entry_low      = price - (risk * 0.3)
        entry_high     = price
    else:
        stop_loss = target_1r = target_2r = entry_low = entry_high = price

    return {
        "direction":        direction,
        "instrument":       instrument,
        "strength":         strength,
        "conditions":       conditions,
        "close_price":      round(price, 2),
        "tenkan":           round(tenkan, 2),
        "kijun":            round(kijun, 2),
        "cloud_top":        round(cloud_top, 2),
        "cloud_bottom":     round(cloud_bottom, 2),
        "cloud_color":      cloud_color,
        "future_cloud":     fct,
        "stop_loss":        round(stop_loss, 2),
        "target_1r":        round(target_1r, 2),
        "target_2r":        round(target_2r, 2),
        "entry_zone_low":   round(entry_low, 2),
        "entry_zone_high":  round(entry_high, 2),
        "inside_cloud":     inside_cloud,
    }


