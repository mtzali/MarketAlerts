def fetch_rtx_4h(lookback_days: int = 90) -> pd.DataFrame:
    """
    Download RTY hourly data and resample to 4H.
    Yahoo Finance doesn't have a native 4H interval,
    so we fetch 1H and resample.
    """
    log.info(f"Fetching {TICKER} hourly data ({lookback_days} day lookback)...")
    try:
        ticker = yf.Ticker(TICKER)
        # Yahoo allows up to 730 days for 1h interval
        df = ticker.history(period=f"{lookback_days}d", interval="1h")

        if df.empty:
            log.error("No data returned from Yahoo Finance.")
            return pd.DataFrame()

        # Resample to 4H (market sessions, starting from open)
        df_4h = df.resample("4h", closed="left", label="left").agg({
            "Open":   "first",
            "High":   "max",
            "Low":    "min",
            "Close":  "last",
            "Volume": "sum",
        }).dropna(subset=["Close"])

        log.info(f"Fetched {len(df_4h)} 4H candles (resampled from 1H).")
        return df_4h

    except Exception as e:
        log.error(f"Error fetching data: {e}")
        return pd.DataFrame()


# ══════════════════════════════════════════════
#  ICHIMOKU ENGINE
# ══════════════════════════════════════════════

def _midpoint(series_high: pd.Series, series_low: pd.Series, period: int) -> pd.Series:
    """(Highest High + Lowest Low) / 2 over N periods."""
    return (series_high.rolling(period).max() + series_low.rolling(period).min()) / 2


def calculate_ichimoku(df: pd.DataFrame) -> pd.DataFrame:
    """
    Calculate all 5 Ichimoku components plus derived fields.
    Returns enriched DataFrame.
    """
    high  = df["High"]
    low   = df["Low"]
    close = df["Close"]

    tenkan = _midpoint(high, low, TENKAN_PERIOD)
    kijun  = _midpoint(high, low, KIJUN_PERIOD)

    # Senkou Span A & B — shifted 26 periods forward
    span_a = ((tenkan + kijun) / 2).shift(DISPLACEMENT)
    span_b = _midpoint(high, low, SENKOU_B_PERIOD).shift(DISPLACEMENT)

    # Chikou Span — close shifted 26 periods backward
    chikou = close.shift(-DISPLACEMENT)

    # Current cloud top/bottom (at current candle)
    cloud_top    = pd.concat([span_a, span_b], axis=1).max(axis=1)
    cloud_bottom = pd.concat([span_a, span_b], axis=1).min(axis=1)
    cloud_color  = np.where(span_a >= span_b, "GREEN", "RED")

    # Future cloud = 26 bars ahead (what the cloud looks like NOW, forward-looking)
    future_span_a = (tenkan + kijun) / 2   # not displaced — this IS the future value
    future_span_b = _midpoint(high, low, SENKOU_B_PERIOD)
    future_cloud_top    = pd.concat([future_span_a, future_span_b], axis=1).max(axis=1)
    future_cloud_bottom = pd.concat([future_span_a, future_span_b], axis=1).min(axis=1)
    future_cloud_color  = np.where(future_span_a >= future_span_b, "GREEN", "RED")

    result = pd.DataFrame({
        "close":               close,
        "tenkan":              tenkan,
        "kijun":               kijun,
        "span_a":              span_a,
        "span_b":              span_b,
        "chikou":              chikou,
        "cloud_top":           cloud_top,
        "cloud_bottom":        cloud_bottom,
        "cloud_color":         cloud_color,
        "future_cloud_top":    future_cloud_top,
        "future_cloud_bottom": future_cloud_bottom,
        "future_cloud_color":  future_cloud_color,
    }, index=df.index)

    return result


